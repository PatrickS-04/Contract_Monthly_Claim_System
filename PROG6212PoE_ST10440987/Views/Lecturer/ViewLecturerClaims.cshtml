@model List<Claim>

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<div style="position: fixed; top: 60px; left: 15px; z-index: 1000;">
    <a asp-controller="Lecturer" asp-action="Index">
        <img src="~/icons/Home Arrow.svg" alt="Back to Lecturer Dashboard" width="50px" height="50px" style="filter: invert(92%) sepia(100%) saturate(7500%) hue-rotate(2deg) brightness(100%) contrast(100%);">
    </a>
</div>

<div class="text-center">
    <p class="display-4" style="font-size: 40px; color: #ffffff; text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);">View Your Claims</p>

    <div class="container mt-5">
        <select type="text" id="claimStatus" class="form-control" required
                style="margin-top: 10px; margin-top: 10px; width: 250px; height: 35px; border: 2px solid #0059df;">
            <option value="">Select Claim Status</option>
            <option value="pending">Pending</option>
            <option value="verified">Verified</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
        </select>

        @if (!Model.Any())
        {
            <p class="text-center" style="color: #ffffff; text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);">You do not have any claims as of this moment in time</p>
        }

        else
        {
            <h5 class="card-title mb-3" id="claimsCounter" style="color: #ffffff; text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);">Your Claims: (@Model.Count)</h5>
            <table id="claimsTable" class="table table-bordered table-striped">
                <thead class="table-primary">
                    <tr>
                        <th>Hours Worked</th>
                        <th>Hourly Rate (Rands)</th>
                        <th>Additional Notes</th>
                        <th>Total Amount (Rands)</th>
                        <th>Date of Claim</th>
                        <th>Claim Status</th>
                        <th>Supporting Document</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model)
                    {
                        <tr data-status="@claim.claimStatus" style="color: #ffffff; text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);">
                            <td>@claim.hoursWorked</td>
                            <td>@claim.hourlyRate</td>
                            <td>@claim.additionalNotes</td>
                            <td>@(claim.hoursWorked * claim.hourlyRate)</td>
                            <td>@claim.dateOfClaim?.ToShortDateString()</td>
                            <td>@claim.claimStatus</td>
                            <td>
                                @if (claim.SupportingDocument != null)
                                {
                                    <a asp-action="DownloadSupportingDocument" asp-route-claimId="@claim.ClaimId" 
                                    class="btn btn-warning btn-sm">Download</a>
                                }
                                else
                                {
                                    <span style="color: #ffffff; text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);">No Supporting Document for this claim</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script>
    document.getElementById("claimStatus").addEventListener("change", function () 
    {
        var chosenStatus = this.value;
        var rows = document.querySelectorAll("#claimsTable tbody tr");
        var claimsCount = 0;

        rows.forEach(function (row) 
        {
            var status = row.getAttribute("data-status");
            if (chosenStatus === "" || status.toLowerCase() === chosenStatus.toLowerCase())
            {
                row.style.display = "";
                claimsCount++;
            } 
            else 
            {
                row.style.display = "none";
            }
        });

        document.getElementById("claimsCounter").textContent = `Your Claims: (${claimsCount})`;

    });
</script>