<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROG6212PoE_ST10440987</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/PROG6212PoE_ST10440987.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Contract Monthly Claim System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @if (User.IsInRole("Lecturer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Lecturer" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Lecturer" asp-action="SubmitClaim">Submit Claim</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Lecturer" asp-action="ViewLecturerClaims">View Your Claims</a>
                                </li>
                                <li class="nav-item ms-auto">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Logout">Logout</a>
                                </li>
                            }

                            @if (User.IsInRole("Academic Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="AcademicManager" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="AcademicManager" asp-action="ViewVerifiedClaims">Approve or Reject Claim</a>
                                </li>
                                <li class="nav-item ms-auto">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Logout">Logout</a>
                                </li>
                            }

                            @if (User.IsInRole("Programme Coordinator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="ProgrammeCoordinator" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="ProgrammeCoordinator" asp-action="ViewPendingClaims">Verify or Reject Claim</a>
                                </li>
                                <li class="nav-item ms-auto">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Logout">Logout</a>
                                </li>
                            }
                            @if (User.IsInRole("HR"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="HR" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="HR" asp-action="AddNewUser">Create New Users</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="HR" asp-action="ShowAllUsers">View All Existing Users</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="HR" asp-action="GenerateSummaryReport">View Reports for Approved Claims</a>
                                </li>
                                <li class="nav-item ms-auto">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Logout">Logout</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            Contract Monthly Claim System - &copy; 2025
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
