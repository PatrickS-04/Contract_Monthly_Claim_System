@model ChangePasswordViewModel

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<style>
    .card {
        border: 3px solid lime !important;
    }
</style>

<div class="text-center">
    <div class="card mx-auto" style="width: 450px;">
        <form enctype="multipart/form-data" method="post" asp-action="ChangePassword">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="card-header d-flex justify-content-center align-items-center" style="font-size: 30px;">
                <p class="m-0">Set your New Password</p>
            </div>
            <div class="card-body">
                <label class="card-title" asp-for="OldPassword" style="margin-top: 10px;"></label>
                <input type="password" id="OldPassword" name="OldPassword" class="form-control" required
                       style="margin-top: 10px; height: 35px; border: 2px solid #0059df;" />

                <label class="card-title" asp-for="NewPassword" style="margin-top: 10px;"></label>
                <input type="password" id="NewPassword" name="NewPassword" class="form-control" required
                       style="margin-top: 10px; height: 35px; border: 2px solid #0059df;" />

                <label class="card-title" asp-for="ConfirmPassword" style="margin-top: 10px;"></label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" required
                       style="margin-top: 10px; height: 35px; border: 2px solid #0059df;" />

                <button type="submit" class="btn btn-success mt-4 rounded-pill w-100" style="height: 35px; font-size: 18px;">Set Password and Login</button>
            </div>
        </form>
    </div>
</div>