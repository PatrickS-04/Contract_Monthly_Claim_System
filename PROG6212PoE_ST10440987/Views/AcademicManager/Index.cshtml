<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center">
        @TempData["SuccessMessage"]
    </div>
}

<div class="text-center">
    <h1 class="display-4" style="color: #ffffff; text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);">Welcome, @User.Identity.Name</h1>
    <p style="color: #ffffff; text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);">This is your Personal Dashboard where you can View Verified Claims and choose to either Approve or Reject the claim!</p>

    <div class="d-flex justify-content-center">
        <div class="card parent-card" style="margin-top: 45px; width: 350px; padding: 20px;">
            <div class="row justify-content-center">
                <a asp-controller="AcademicManager" asp-action="ViewVerifiedClaims" class="card hover-card" style="width: 250px;
                    height: 150px; text-decoration: none;">
                    <img src="https://www.shutterstock.com/image-vector/set-approval-grunge-rubber-stamps-260nw-2262117035.jpg" class="card-img-top img-fluid" style="height: 100px; object-fit: cover;" alt="View Verified Claims image" />
                    <div class="card-body pt-3">
                        <h5 class="card-title mb-3" style="font-size: 17px;">View Verified Claims</h5>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>